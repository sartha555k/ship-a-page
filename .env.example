# Set real values in Vercel. Locally use .env.local (ignored by Git).
# These are server-only. No NEXT_PUBLIC_ keys are needed for this setup.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Random secret, at least 32 characters; used to hash client IPs for quotas.
RATE_LIMIT_HASH_SECRET=

# Optional AI configuration: leave blank until the first AI project is chosen.
# Vercel uses its automatic VERCEL_OIDC_TOKEN if no gateway key is provided.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=

# Non-secret settings. Calls are disabled unless this is explicitly true.
AI_ENABLED=false
API_RATE_LIMIT_PER_MINUTE=5
API_DAILY_REQUEST_LIMIT=100
API_MAX_INPUT_CHARACTERS=4000
AI_MAX_OUTPUT_TOKENS=512
